<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Research-build signing (branch energy-trace): WeatherKit, iCloud/
	     CloudKit, Verifiable Health Records (healthkit.access), and NFC Tag
	     Reading are removed because free personal development teams cannot
	     provision them. Their runtime features degrade: apple-weather and NFC
	     offloads fail loudly, health-records queries are unavailable, and
	     iCloud Sync must stay OFF in app settings (CKContainer is only
	     constructed when sync starts, so launch is safe). Restore the full set
	     from git history / the upstream repo for a paid-team build. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.edu.vt.yuec.minis</string>
	</array>
</dict>
</plist>
